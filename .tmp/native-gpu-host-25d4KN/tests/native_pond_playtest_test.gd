extends "res://tests/service_modal_lifecycle_test.gd"
const JourneyView := preload("res://application/journey_view.gd")
const PondWorld := preload("res://core/garden_world.gd")

func _run() -> void:
	_levels = JSON.parse_string(FileAccess.get_file_as_string("res://content/levels.json")).levels
	_levels.append_array(JSON.parse_string(FileAccess.get_file_as_string("res://content/cloud-levels.json")).levels)
	var world := PondWorld.new("2-1")
	var before: Dictionary = world.snapshot()
	var denied: Dictionary = world.act("valve:water")
	_check(not denied.ok and str(denied.message).contains("清露") and str(denied.message).contains("淹没"),"water denial names endangered dew and cause")
	_same(before,world.snapshot(),"denied water preserves entire puzzle")
	_check(str(world.act("use:care").message).contains("接住露珠"),"care denial names pickup action")
	_check(JourneyView.describe(world).total == 3 and JourneyView.describe(world).done == 0,"dew task distinct from collectible count")
	for tile: String in ["m:float:0:1","f:0:2","f:0:3","f:0:4"]: _check(world.move(tile).ok,"original low route / "+tile)
	_check(world.act("take:dew").ok,"dew pickup offered")
	_check(not world.act("valve:water").ok,"cannot raise water remotely from low path")
	for tile: String in ["f:0:3","f:0:2","m:float:0:1","m:float:0:0"]: _check(world.move(tile).ok,"return carrying dew / "+tile)
	_check(world.act("switch").ok,"switch while other actor carries dew")
	_check(str(world.act("use:care").message).contains("露薇"),"care explains actual other holder")
	_check(world.act("switch").ok and world.act("follow").ok,"restore original carrier and following")
	_check(world.act("valve:water").ok,"carried dew can ascend; care not an artificial valve prerequisite")
	_check(world.point_for("f:2:0").is_empty(),"uncared middle water does not open east landing")
	_check(world.act("valve:water").ok and world.act("valve:water").ok,"three water levels still cycle downward")
	_check(world.act("use:care").ok and world.flag("care"),"deliver dew normally")
	_check(str(world.act("use:care").message).contains("已经收到"),"settled care no longer asks for consumed dew")
	_check(JourneyView.describe(world).done == 2,"two real preparation stages complete")
	_check(world.act("valve:water").ok and not world.point_for("f:2:0").is_empty(),"care plus middle water opens real landing")
	_check(world.act("valve:water").ok and not world.ready(),"high water remains optional, not ready")
	_check(world.undo() and world.ready(),"undo restores middle water")
	var reloaded := PondWorld.new("2-1",world.snapshot())
	_same(world.snapshot(),reloaded.snapshot(),"valid dew/care/water save survives reload")
	var app := _real_app()
	var buddy_world := PondWorld.new("2-1")
	buddy_world.act("switch")
	for tile: String in ["m:float:0:1","f:0:2","f:0:3","f:0:4"]: buddy_world.move(tile)
	_check(not buddy_world.commands().any(func(c: Dictionary) -> bool: return c.id == "take:dew"),"buddy does not gain dew pickup ability")
	app.unlock_all_levels = true
	var store: Dictionary = app.repository.data.duplicate(true)
	app._show_menu()
	for level: Dictionary in app.levels:
		app.hud._chapter_map.select_level(str(level.id))
		_check(not app.hud._chapter_map.preferred_focus.disabled,"all-levels true opens "+str(level.id))
	_same(store,app.repository.data,"unlock selection writes no fake progress")
	for id: String in ["2-1","3-4","cloud-3"]:
		app.hud._chapter_map.select_level(id)
		app.hud._chapter_map.preferred_focus.pressed.emit()
		_check(str(app.session.world.level.id)==id and not app.session.world.state.completed,"actual map entry to "+id)
		app._show_menu()
	_check(app.repository.data.mainline.records.is_empty() and app.repository.data.mainline.memories.is_empty(),"test access creates no completions or memories")
	app.unlock_all_levels = false
	app._show_menu()
	app.hud._chapter_map.select_level("2-1")
	_check(app.hud._chapter_map._entry("2-1").unlocked == false,"false restores sequential gates even after testing")
	app.hud._chapter_map.select_level("1-1")
	_check(app.hud._chapter_map._entry("1-1").unlocked,"first level remains available with flag false")
	app.free()
	await process_frame
	_failures.append_array(_logger.captured_errors())
	print(JSON.stringify({"suite":"native-pond-playtest","checks":_checks,"failures":_failures,"passed":_failures.is_empty()}))
	quit(0 if _failures.is_empty() else 1)
